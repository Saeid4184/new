<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dim_10"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/dim_16"
    app:cardElevation="@dimen/dim_1"
    app:strokeWidth="@dimen/dim_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/dim_14">

        <FrameLayout
            android:layout_width="@dimen/dim_44"
            android:layout_height="@dimen/dim_44"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="@dimen/dim_44"
                android:layout_height="@dimen/dim_44"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivTypeIcon"
                android:layout_width="@dimen/dim_20"
                android:layout_height="@dimen/dim_20"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dim_14"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/concrete_900"
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                tools:text="علی رضایی" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_2"
                android:textColor="@color/concrete_500"
                android:textSize="@dimen/text_size_13"
                tools:text="آخرین وضعیت: داخل کارخانه" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dim_8"
            android:background="@drawable/bg_status_inside"
            android:paddingHorizontal="@dimen/dim_10"
            android:paddingVertical="@dimen/dim_5"
            android:textColor="@color/status_green"
            android:textSize="@dimen/text_size_12"
            android:textStyle="bold"
            tools:text="داخل" />

        <ImageView
            android:layout_width="@dimen/dim_18"
            android:layout_height="@dimen/dim_18"
            android:src="@drawable/ic_chevron_left" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
