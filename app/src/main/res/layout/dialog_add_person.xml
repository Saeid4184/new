<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dim_24">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_name"
        app:boxCornerRadiusBottomEnd="@dimen/dim_12"
        app:boxCornerRadiusBottomStart="@dimen/dim_12"
        app:boxCornerRadiusTopEnd="@dimen/dim_12"
        app:boxCornerRadiusTopStart="@dimen/dim_12">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- For PERSONNEL: exposed dropdown of fixed departments.
         For MACHINERY: free-text fleet/model group. Hidden entirely for VISITOR/DRIVER
         (they use their own dedicated check-in dialogs instead of this one). -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilGroup"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dim_14"
        android:hint="@string/hint_department"
        app:boxCornerRadiusBottomEnd="@dimen/dim_12"
        app:boxCornerRadiusBottomStart="@dimen/dim_12"
        app:boxCornerRadiusTopEnd="@dimen/dim_12"
        app:boxCornerRadiusTopStart="@dimen/dim_12">

        <AutoCompleteTextView
            android:id="@+id/etGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilExtraInfo"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dim_14"
        android:hint="@string/hint_extra_info"
        app:boxCornerRadiusBottomEnd="@dimen/dim_12"
        app:boxCornerRadiusBottomStart="@dimen/dim_12"
        app:boxCornerRadiusTopEnd="@dimen/dim_12"
        app:boxCornerRadiusTopStart="@dimen/dim_12">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etExtraInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchBlacklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dim_14"
        android:text="@string/hint_blacklist"
        android:textSize="@dimen/text_size_13"
        android:visibility="gone" />

</LinearLayout>
