<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dim_16"
        android:layout_marginBottom="@dimen/dim_4"
        android:hint="@string/search_hint"
        app:boxCornerRadiusBottomEnd="@dimen/dim_14"
        app:boxCornerRadiusBottomStart="@dimen/dim_14"
        app:boxCornerRadiusTopEnd="@dimen/dim_14"
        app:boxCornerRadiusTopStart="@dimen/dim_14"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvInsideCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dim_16"
        android:layout_marginBottom="@dimen/dim_8"
        android:textColor="@color/concrete_500"
        android:textSize="@dimen/text_size_12"
        tools:text="۳ ماشین داخل پارکینگ" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dim_40"
        android:gravity="center"
        android:padding="@dimen/dim_24"
        android:text="@string/parking_machinery_empty"
        android:textColor="@color/concrete_500"
        android:textSize="@dimen/text_size_14"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dim_16" />

</LinearLayout>
