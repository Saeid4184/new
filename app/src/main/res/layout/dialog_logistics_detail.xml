<?xml version="1.0" encoding="utf-8"?>
<!-- Machinery / LOGISTICS ("تدارکات") only: no goods enter the factory without an invoice
     number, and no goods leave without an exit-slip number. Reused for both check-in (invoice)
     and check-out (exit slip) — hint text, checkbox label, and field requirement are swapped
     at runtime by CategoryFragment. The checkbox is the escape hatch for a vehicle that is
     simply arriving/leaving empty (no goods involved), so the number field isn't forced when
     there's genuinely nothing to document. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dim_24">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDocNumber"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusBottomEnd="@dimen/dim_12"
        app:boxCornerRadiusBottomStart="@dimen/dim_12"
        app:boxCornerRadiusTopEnd="@dimen/dim_12"
        app:boxCornerRadiusTopStart="@dimen/dim_12">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDocNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbNoCargo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dim_10"
        android:textSize="@dimen/text_size_13" />

</LinearLayout>
