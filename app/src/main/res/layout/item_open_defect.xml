<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ConcreteFactory.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dim_10"
    app:cardBackgroundColor="@color/danger_red_glass"
    app:strokeColor="@color/danger_red">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dim_14">

        <TextView
            android:id="@+id/tvVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/concrete_900"
            android:textSize="@dimen/text_size_15"
            android:textStyle="bold"
            tools:text="پلاک 69744 — کمپرسی تریلی" />

        <TextView
            android:id="@+id/tvPart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim_4"
            android:textColor="@color/danger_red"
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            tools:text="آینه چپ — خراب" />

        <TextView
            android:id="@+id/tvRecurringBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim_4"
            android:background="@drawable/bg_status_outside"
            android:paddingHorizontal="@dimen/dim_8"
            android:paddingVertical="@dimen/dim_3"
            android:text="@string/open_defects_recurring_badge"
            android:textColor="@color/danger_red"
            android:textSize="@dimen/text_size_11"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim_6"
            android:textColor="@color/concrete_500"
            android:textSize="@dimen/text_size_13"
            tools:text="شکسته شده، نیاز به تعویض" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepaired"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim_8"
            android:layout_gravity="start"
            android:text="@string/open_defects_mark_repaired" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
