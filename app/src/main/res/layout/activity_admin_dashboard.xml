<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg"
        android:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dim_20">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/dashboard_live_now" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingHorizontal="@dimen/dim_10"
                android:rowCount="2">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="@dimen/dim_6"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/dim_16"
                    app:cardElevation="@dimen/dim_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dim_14">

                        <ImageView
                            android:layout_width="@dimen/dim_22"
                            android:layout_height="@dimen/dim_22"
                            android:src="@drawable/ic_personnel"
                            app:tint="@color/concrete_900" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dim_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountPersonnel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/concrete_900"
                                android:textSize="@dimen/text_size_20"
                                android:textStyle="bold"
                                tools:text="۳" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/category_personnel"
                                android:textColor="@color/concrete_500"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="@dimen/dim_6"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/dim_16"
                    app:cardElevation="@dimen/dim_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dim_14">

                        <ImageView
                            android:layout_width="@dimen/dim_22"
                            android:layout_height="@dimen/dim_22"
                            android:src="@drawable/ic_machinery"
                            app:tint="@color/concrete_900" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dim_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountMachinery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/concrete_900"
                                android:textSize="@dimen/text_size_20"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/category_machinery"
                                android:textColor="@color/concrete_500"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="@dimen/dim_6"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/dim_16"
                    app:cardElevation="@dimen/dim_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dim_14">

                        <ImageView
                            android:layout_width="@dimen/dim_22"
                            android:layout_height="@dimen/dim_22"
                            android:src="@drawable/ic_visitor"
                            app:tint="@color/concrete_900" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dim_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountVisitor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/concrete_900"
                                android:textSize="@dimen/text_size_20"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/category_visitor"
                                android:textColor="@color/concrete_500"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="@dimen/dim_6"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/dim_16"
                    app:cardElevation="@dimen/dim_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dim_14">

                        <ImageView
                            android:layout_width="@dimen/dim_22"
                            android:layout_height="@dimen/dim_22"
                            android:src="@drawable/ic_driver"
                            app:tint="@color/concrete_900" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dim_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountDriver"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/concrete_900"
                                android:textSize="@dimen/text_size_20"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/category_driver"
                                android:textColor="@color/concrete_500"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/dashboard_items_today_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dim_10">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/dim_6"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/dim_16"
                    app:cardElevation="@dimen/dim_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dim_14">

                        <ImageView
                            android:layout_width="@dimen/dim_22"
                            android:layout_height="@dimen/dim_22"
                            android:src="@drawable/ic_inventory"
                            app:tint="@color/status_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dim_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountItemsInToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/concrete_900"
                                android:textSize="@dimen/text_size_20"
                                android:textStyle="bold"
                                tools:text="۰" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_items_in_today"
                                android:textColor="@color/concrete_500"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/dim_6"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/dim_16"
                    app:cardElevation="@dimen/dim_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dim_14">

                        <ImageView
                            android:layout_width="@dimen/dim_22"
                            android:layout_height="@dimen/dim_22"
                            android:src="@drawable/ic_inventory"
                            app:tint="@color/danger_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dim_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountItemsOutToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/concrete_900"
                                android:textSize="@dimen/text_size_20"
                                android:textStyle="bold"
                                tools:text="۰" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_items_out_today"
                                android:textColor="@color/concrete_500"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dim_16"
                android:layout_marginTop="@dimen/dim_14"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenSetup"
                    style="@style/Widget.ConcreteFactory.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_open_setup"
                    android:textSize="@dimen/text_size_12"
                    app:icon="@drawable/ic_setup" />
            </LinearLayout>

            <!-- Report generation & Excel export — merged in from the old standalone Report
                 screen, so live monitoring and reporting now live on one in-app dashboard
                 instead of being split across two screens (and there's no separate web panel
                 to open for any of this anymore). -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/dashboard_reports_header" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dim_16"
                android:layout_marginTop="@dimen/dim_0"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/dim_18"
                app:cardElevation="@dimen/dim_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dim_20">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDateRange"
                        style="@style/Widget.ConcreteFactory.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_calendar" />

                    <TextView
                        android:id="@+id/tvRowCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_16"
                        android:gravity="center"
                        android:textColor="@color/concrete_500"
                        android:textSize="@dimen/text_size_14" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_20"
                        android:backgroundTint="@color/safety_amber"
                        android:paddingVertical="@dimen/dim_12"
                        android:text="@string/report_export_button"
                        android:textColor="@color/concrete_900"
                        app:icon="@drawable/ic_export"
                        app:iconTint="@color/concrete_900" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dim_16"
                android:layout_marginTop="@dimen/dim_0"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/dim_18"
                app:cardElevation="@dimen/dim_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dim_20">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportInspections"
                        style="@style/Widget.ConcreteFactory.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/inspection_export_button"
                        app:icon="@drawable/ic_inspection" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFleetHeatmap"
                        style="@style/Widget.ConcreteFactory.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_10"
                        android:text="@string/fleet_heatmap_open_button"
                        app:icon="@drawable/ic_inspection" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenDefects"
                        style="@style/Widget.ConcreteFactory.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_10"
                        android:text="@string/open_defects_title"
                        app:icon="@drawable/ic_inspection" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportItemLogs"
                        style="@style/Widget.ConcreteFactory.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_10"
                        android:text="@string/item_log_export_button"
                        app:icon="@drawable/ic_inventory" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dim_16"
                android:layout_marginTop="@dimen/dim_0"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/dim_18"
                app:cardElevation="@dimen/dim_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dim_20">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiAnalyze"
                        style="@style/Widget.ConcreteFactory.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_analyze_button"
                        app:icon="@drawable/ic_ai_spark" />

                    <ProgressBar
                        android:id="@+id/progressAi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dim_12"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvAiResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_14"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/concrete_900"
                        android:textSize="@dimen/text_size_14"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/dashboard_all_inside_header" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_30"
                android:gravity="center"
                android:padding="@dimen/dim_24"
                android:text="@string/dashboard_empty_inside"
                android:textColor="@color/concrete_500"
                android:textSize="@dimen/text_size_14"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/dim_16" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
